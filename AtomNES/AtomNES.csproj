<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\AtomNES.ico</ApplicationIcon>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AtomUI.Desktop.Controls" Version="6.2.5" />
        <PackageReference Include="AtomUI.Desktop.Controls.DataGrid" Version="6.2.5" />
        <PackageReference Include="AtomUI.Desktop.Controls.ColorPicker" Version="6.2.5" />
        <PackageReference Include="AtomUI.Desktop.Controls.Extras" Version="6.2.5" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\AtomNES.Device\AtomNES.Device.csproj" />
    </ItemGroup>
</Project>

