<atom:Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    xmlns:vm="using:AtomNES.ViewModels"
    xmlns:l="using:AtomNES.Localization"
    x:Class="AtomNES.Views.DebuggerWindow"
    x:DataType="vm:DebuggerViewModel"
    Title="{l:AppLangResource DebuggerTitle}" Icon="/Assets/AtomNES.ico" Width="980" Height="720" MinWidth="800" MinHeight="560">

    <DockPanel Margin="12">
        <!-- 工具栏 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <atom:Button ButtonType="Primary" Command="{Binding ToggleRunCommand}" Content="{Binding RunButtonText}"
                         Icon="{antdicons:AntDesignIconProvider Kind=CaretRightOutlined}" />
            <atom:Button Command="{Binding StepInstructionCommand}" Content="{l:AppLangResource DbgStepInstruction}"
                         Icon="{antdicons:AntDesignIconProvider Kind=StepForwardOutlined}" />
            <atom:Button Command="{Binding StepScanlineCommand}" Content="{l:AppLangResource DbgStepScanline}"
                         Icon="{antdicons:AntDesignIconProvider Kind=VerticalAlignBottomOutlined}" />
            <atom:Button Command="{Binding StepFrameCommand}" Content="{l:AppLangResource DbgStepFrame}"
                         Icon="{antdicons:AntDesignIconProvider Kind=FastForwardOutlined}" />
            <atom:Button ButtonType="Dashed" Command="{Binding ResetCommand}" Content="{l:AppLangResource DbgReset}"
                         Icon="{antdicons:AntDesignIconProvider Kind=ReloadOutlined}" />
            <atom:Button ButtonType="Text" Command="{Binding RefreshCommand}" Content="{l:AppLangResource DbgRefresh}"
                         Icon="{antdicons:AntDesignIconProvider Kind=RedoOutlined}" />
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                <atom:ToggleSwitch IsChecked="{Binding AutoRefresh}" />
                <atom:TextBlock Text="{l:AppLangResource DbgAutoRefresh}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <atom:TabControl>
            <!-- CPU -->
            <atom:TabItem Header="CPU">
                <Grid ColumnDefinitions="*,12,300">
                    <atom:Card Grid.Column="0" Header="{l:AppLangResource DbgDisassembly}">
                        <atom:ListBox ItemsSource="{Binding Disassembly}" SelectedItem="{Binding CurrentLine}"
                                      SizeType="Small" IsShowSelectedIndicator="False">
                            <atom:ListBox.Styles>
                                <Style Selector="atom|ListBoxItem">
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </atom:ListBox.Styles>
                            <atom:ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DisasmLine">
                                    <Grid ColumnDefinitions="18,70,90,*" VerticalAlignment="Center">
                                        <Grid.Styles>
                                            <Style Selector="atom|TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </Grid.Styles>
                                        <atom:TextBlock Grid.Column="0" Text="▶" Foreground="{atom:SharedTokenResource ColorError}"
                                                        IsVisible="{Binding IsCurrent}" />
                                        <atom:TextBlock Grid.Column="1" Text="{Binding AddressText}" FontFamily="Consolas,monospace"
                                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                        <atom:TextBlock Grid.Column="2" Text="{Binding Bytes}" FontFamily="Consolas,monospace"
                                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                                        <atom:TextBlock Grid.Column="3" Text="{Binding Text}" FontFamily="Consolas,monospace" />
                                    </Grid>
                                </DataTemplate>
                            </atom:ListBox.ItemTemplate>
                        </atom:ListBox>
                    </atom:Card>

                    <StackPanel Grid.Column="2" Spacing="12">
                        <atom:Card Header="{l:AppLangResource DbgRegisters}">
                            <ItemsControl ItemsSource="{Binding CpuRegisters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RegisterItem">
                                        <Grid ColumnDefinitions="60,*" Margin="0,2" MinHeight="24">
                                            <atom:TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                            <atom:TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </atom:Card>
                        <atom:Card Header="{l:AppLangResource DbgFlags}">
                            <ItemsControl ItemsSource="{Binding CpuFlags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FlagItem">
                                        <Panel HorizontalAlignment="Center">
                                            <atom:Tag Text="{Binding Name}" TagColor="green" IsVisible="{Binding IsSet}" Margin="0" />
                                            <atom:Tag Text="{Binding Name}" IsVisible="{Binding !IsSet}" Margin="0" />
                                        </Panel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </atom:Card>
                    </StackPanel>
                </Grid>
            </atom:TabItem>

            <!-- PPU -->
            <atom:TabItem Header="PPU">
                <Grid ColumnDefinitions="Auto,12,*">
                    <StackPanel Spacing="12">
                        <atom:Card Header="{l:AppLangResource DbgPatternTables}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <StackPanel Spacing="4">
                                        <atom:TextBlock Text="$0000" Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                        <Image Source="{Binding PatternTable0}" Width="256" Height="256"
                                               RenderOptions.BitmapInterpolationMode="None" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <atom:TextBlock Text="$1000" Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                        <Image Source="{Binding PatternTable1}" Width="256" Height="256"
                                               RenderOptions.BitmapInterpolationMode="None" />
                                    </StackPanel>
                                </StackPanel>
                                <atom:Segmented SelectedIndex="{Binding SelectedPalette}">
                                    <atom:SegmentedItem Content="BG0" />
                                    <atom:SegmentedItem Content="BG1" />
                                    <atom:SegmentedItem Content="BG2" />
                                    <atom:SegmentedItem Content="BG3" />
                                    <atom:SegmentedItem Content="SP0" />
                                    <atom:SegmentedItem Content="SP1" />
                                    <atom:SegmentedItem Content="SP2" />
                                    <atom:SegmentedItem Content="SP3" />
                                </atom:Segmented>
                            </StackPanel>
                        </atom:Card>
                        <atom:Card Header="{l:AppLangResource DbgPaletteRam}">
                            <ItemsControl ItemsSource="{Binding PaletteBrushes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="16" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="28" Height="28" Margin="2" CornerRadius="4"
                                                BorderThickness="1" BorderBrush="{atom:SharedTokenResource ColorBorder}"
                                                Background="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </atom:Card>
                    </StackPanel>

                    <atom:Card Grid.Column="2" Header="{l:AppLangResource DbgPpuState}">
                        <ItemsControl ItemsSource="{Binding PpuRegisters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RegisterItem">
                                    <Grid ColumnDefinitions="80,*" Margin="0,2" MinHeight="24">
                                        <atom:TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                        <atom:TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </atom:Card>
                </Grid>
            </atom:TabItem>

            <!-- 名称表 -->
            <atom:TabItem Header="{l:AppLangResource DbgNametables}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                    <Image Source="{Binding NameTables}" Width="512" Height="480" HorizontalAlignment="Left" VerticalAlignment="Top"
                           RenderOptions.BitmapInterpolationMode="None" />
                </ScrollViewer>
            </atom:TabItem>
        </atom:TabControl>
    </DockPanel>
</atom:Window>
